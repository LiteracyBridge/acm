<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.shape.SVGPath?>

<HBox alignment="CENTER_LEFT" styleClass="topbar"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.literacybridge.acm.gui.fx.dashboard.TopBarController">

    <Button fx:id="menuButton" accessibleText="Toggle menu" mnemonicParsing="false"
            styleClass="icon-button" onAction="#handleMenuToggle">
        <graphic>
            <SVGPath styleClass="icon" content="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
        </graphic>
        <tooltip>
            <Tooltip text="Toggle menu"/>
        </tooltip>
    </Button>

    <ImageView fitHeight="40.0" preserveRatio="true" accessibleText="Amplio">
        <Image url="@../../../../../images/amplio-logo.png"/>
    </ImageView>

    <Region HBox.hgrow="ALWAYS"/>

    <ComboBox fx:id="programComboBox" accessibleText="Program" prefWidth="240.0"
              promptText="Select program" styleClass="program-select"/>

    <Button fx:id="settingsButton" accessibleText="Settings" mnemonicParsing="false"
            styleClass="icon-button">
        <graphic>
            <SVGPath styleClass="icon" content="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
        </graphic>
        <tooltip>
            <Tooltip text="Settings"/>
        </tooltip>
    </Button>

    <Button fx:id="helpButton" accessibleText="Help" mnemonicParsing="false"
            styleClass="icon-button">
        <graphic>
            <SVGPath styleClass="icon" content="M11 18h2v-2h-2v2zm1-16C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-2.21 0-4 1.790-4 4h2c0-1.1.9-2 2-2s2 .9 2 2c0 2-3 1.75-3 5h2c0-2.25 3-2.5 3-5 0-2.21-1.79-4-4-4z"/>
        </graphic>
        <tooltip>
            <Tooltip text="Help"/>
        </tooltip>
    </Button>

    <Button fx:id="avatarButton" accessibleText="Account" mnemonicParsing="false"
            styleClass="avatar">
        <tooltip>
            <Tooltip text="Account"/>
        </tooltip>
    </Button>
</HBox>