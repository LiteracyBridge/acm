<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane prefHeight="760.0" prefWidth="1280.0" style="-fx-background-color: white;"
           xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.literacybridge.acm.gui.fx.LoginController">
    <VBox alignment="CENTER" maxWidth="360.0" minWidth="280.0" prefWidth="360.0" spacing="12.0">
        <ImageView fitWidth="120.0" preserveRatio="true">
            <VBox.margin>
                <Insets top="14.0" bottom="20.0"/>
            </VBox.margin>
            <Image url="@../../../../images/amplio-logo.png"/>
        </ImageView>

        <Label text="Login to Audio Content Manager---"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;">
            <VBox.margin>
                <Insets bottom="16.0"/>
            </VBox.margin>
        </Label>

        <VBox maxWidth="360.0" spacing="6.0">
            <Label text="Email" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1F2937;"/>
            <TextField fx:id="emailField" accessibleText="Email" prefHeight="34.0"
                       promptText="Enter email"
                       style="-fx-font-size: 12px; -fx-background-radius: 4; -fx-border-color: #D1D5DB; -fx-border-radius: 4;"/>
        </VBox>

        <VBox maxWidth="360.0" spacing="6.0">
            <Label text="Password" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1F2937;"/>
            <StackPane>
                <PasswordField fx:id="passwordField" accessibleText="Password" prefHeight="34.0"
                               promptText="Enter password"
                               style="-fx-font-size: 12px; -fx-background-radius: 4; -fx-border-color: #D1D5DB; -fx-border-radius: 4; -fx-padding: 0 36 0 8;"/>
                <TextField fx:id="visiblePasswordField" accessibleText="Password" prefHeight="34.0"
                           promptText="Enter password" visible="false" managed="false"
                           style="-fx-font-size: 12px; -fx-background-radius: 4; -fx-border-color: #D1D5DB; -fx-border-radius: 4; -fx-padding: 0 36 0 8;"/>
                <ToggleButton fx:id="passwordVisibilityButton" onAction="#handlePasswordVisibility"
                              accessibleText="Show or hide password" prefWidth="32.0" prefHeight="30.0"
                              style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0;">
                    <graphic>
                        <SVGPath content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5C21.27 7.61 17 4.5 12 4.5zm0 12.5a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-2a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"
                                style="-fx-fill: #1F2937;"/>
                    </graphic>
                    <StackPane.alignment>CENTER_RIGHT</StackPane.alignment>
                </ToggleButton>
            </StackPane>
        </VBox>

        <HBox alignment="CENTER_RIGHT" maxWidth="360.0">
            <Hyperlink fx:id="forgotPasswordLink" onAction="#handleForgotPassword" text="Forgot Password"
                       style="-fx-font-size: 10px; -fx-text-fill: #6B7280; -fx-padding: 0;"/>
        </HBox>

        <Label fx:id="messageLabel" minHeight="18.0" text="" wrapText="true"
               style="-fx-font-size: 11px; -fx-text-fill: #B42318;"/>

        <Button fx:id="loginButton" defaultButton="true" onAction="#handleLogin" prefHeight="34.0" prefWidth="72.0"
                text="Login"
                style="-fx-background-color: #35A66B; -fx-background-radius: 4; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;">
            <VBox.margin>
                <Insets top="2.0" bottom="6.0"/>
            </VBox.margin>
        </Button>

        <HBox alignment="CENTER" spacing="4.0">
            <Label text="Don't have an account yet?" style="-fx-font-size: 10px; -fx-text-fill: #111827;"/>
            <Hyperlink fx:id="signUpLink" onAction="#handleSignUp" text="Sign Up"
                       style="-fx-font-size: 10px; -fx-text-fill: #6B7280; -fx-padding: 0;"/>
        </HBox>

        <!-- Kept for the existing controller; this option is not part of the approved Figma login design. -->
        <CheckBox fx:id="rememberMeCheckBox" managed="false" selected="true" visible="false"/>
    </VBox>
</StackPane>
