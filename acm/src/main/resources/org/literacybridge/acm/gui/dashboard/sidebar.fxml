<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox styleClass="sidebar"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.literacybridge.acm.gui.fx.dashboard.SidebarController">

    <fx:define>
        <ToggleGroup fx:id="navGroup"/>
    </fx:define>

    <VBox spacing="4.0">
        <ToggleButton fx:id="audioLibraryNav" text="Audio Library" userData="audioLibrary"
                      toggleGroup="$navGroup" selected="true" mnemonicParsing="false"
                      maxWidth="Infinity" styleClass="nav-item">
            <graphic>
                <SVGPath styleClass="icon" content="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
            </graphic>
        </ToggleButton>

        <ToggleButton fx:id="importContentNav" text="Import Content" userData="importContent"
                      toggleGroup="$navGroup" mnemonicParsing="false"
                      maxWidth="Infinity" styleClass="nav-item">
            <graphic>
                <SVGPath styleClass="icon" content="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11zM8 15.01l1.41 1.41L11 14.84V19h2v-4.16l1.59 1.59L16 15.01 12.01 11 8 15.01z"/>
            </graphic>
        </ToggleButton>

        <ToggleButton fx:id="playlistPromptsNav" text="Playlists Prompts" userData="playlistPrompts"
                      toggleGroup="$navGroup" mnemonicParsing="false"
                      maxWidth="Infinity" styleClass="nav-item">
            <graphic>
                <SVGPath styleClass="icon" content="M14 10H3v2h11v-2zm0-4H3v2h11V6zm4 8v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zM3 16h7v-2H3v2z"/>
            </graphic>
        </ToggleButton>

        <ToggleButton fx:id="systemPromptsNav" text="System Prompts" userData="systemPrompts"
                      toggleGroup="$navGroup" mnemonicParsing="false"
                      maxWidth="Infinity" styleClass="nav-item">
            <graphic>
                <SVGPath styleClass="icon" content="M20 4H4c-1.11 0-2 .9-2 2v12c0 1.1.89 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.89-2-2-2zm0 14H4V8h16v10zm-2-1h-6v-2h6v2zM7.5 17l-1.41-1.41L8.67 13l-2.59-2.59L7.5 9l4 4-4 4z"/>
            </graphic>
        </ToggleButton>

        <ToggleButton fx:id="customGreetingsNav" text="Custom Greetings" userData="customGreetings"
                      toggleGroup="$navGroup" mnemonicParsing="false"
                      maxWidth="Infinity" styleClass="nav-item">
            <graphic>
                <SVGPath styleClass="icon" content="M9 13c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0-6c1.1 0 2 .9 2 2s-.9 2-2 2-2-.9-2-2 .9-2 2-2zm0 8c-2.67 0-8 1.34-8 4v3h16v-3c0-2.66-5.33-4-8-4zm6 5H3v-.99C3.2 18.29 6.3 17 9 17s5.8 1.29 6 2v1zM16.76 5.36l-1.68 1.69c.84 1.18.84 2.71 0 3.89l1.68 1.69c2.02-2.02 2.02-5.07 0-7.27zM20.07 2l-1.63 1.63c2.77 3.02 2.77 7.56 0 10.74L20.07 16c3.9-3.89 3.91-9.95 0-14z"/>
            </graphic>
        </ToggleButton>

        <ToggleButton fx:id="createDeploymentsNav" text="Create Deployments" userData="createDeployments"
                      toggleGroup="$navGroup" mnemonicParsing="false"
                      maxWidth="Infinity" styleClass="nav-item">
            <graphic>
                <SVGPath styleClass="icon" content="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
            </graphic>
        </ToggleButton>
    </VBox>

    <Separator styleClass="sidebar-divider"/>

    <HBox alignment="CENTER_LEFT" styleClass="section-header">
        <Label text="Playlists" styleClass="section-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addPlaylistButton" accessibleText="New playlist" mnemonicParsing="false"
                styleClass="icon-button">
            <graphic>
                <SVGPath styleClass="icon" content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
            </graphic>
            <tooltip>
                <Tooltip text="New playlist"/>
            </tooltip>
        </Button>
    </HBox>

    <ListView fx:id="playlistList" VBox.vgrow="ALWAYS" styleClass="playlist-list"/>
</VBox>
