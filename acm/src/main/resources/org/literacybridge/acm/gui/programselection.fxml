<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="760.0" prefWidth="1280.0"
           style="-fx-background-color: white;"
           xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
    <VBox alignment="CENTER" maxWidth="360.0" minWidth="280.0" prefWidth="360.0" spacing="12.0">
        <Label text="Welcome"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;">
            <VBox.margin>
                <Insets bottom="4.0"/>
            </VBox.margin>
        </Label>

        <Label text="Please select a program to get started."
               style="-fx-font-size: 14px; -fx-text-fill: #4B5563;">
            <VBox.margin>
                <Insets bottom="34.0"/>
            </VBox.margin>
        </Label>

        <Label text="Program"
               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1F2937;">
            <VBox.margin>
                <Insets bottom="6.0"/>
            </VBox.margin>
        </Label>

        <ComboBox fx:id="programComboBox" accessibleText="Program"
                  maxWidth="Infinity" prefHeight="42.0" promptText="Select"
                  style="-fx-font-size: 14px;">
            <VBox.margin>
                <Insets bottom="18.0"/>
            </VBox.margin>
        </ComboBox>

        <HBox alignment="CENTER_RIGHT">
            <children>
                <Button fx:id="openButton" defaultButton="true" disable="true"
                        mnemonicParsing="false" prefWidth="64.0" prefHeight="40.0"
                        text="Next"
                        style="-fx-background-color: #32A56F; -fx-background-radius: 4; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
            </children>
        </HBox>
    </VBox>
</StackPane>