<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox spacing="24.0"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.literacybridge.acm.gui.fx.dashboard.AudioLibraryController">

    <Label text="Audio Library" styleClass="page-title"/>

    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <HBox alignment="CENTER_LEFT" prefWidth="420.0" maxWidth="420.0" styleClass="search-box">
            <SVGPath styleClass="icon" content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
            <TextField fx:id="searchField" accessibleText="Search audio" promptText="Search audio"
                       HBox.hgrow="ALWAYS" styleClass="search-field"/>
        </HBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button fx:id="filtersButton" text="Apply Filters" mnemonicParsing="false" styleClass="btn-secondary">
            <graphic>
                <SVGPath styleClass="icon" content="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"/>
            </graphic>
        </Button>

        <Button fx:id="columnsButton" text="Columns" mnemonicParsing="false" styleClass="btn-secondary">
            <graphic>
                <SVGPath styleClass="icon" fillRule="EVEN_ODD" content="M3 3h18v18H3V3zm2 2v4h14V5H5zm0 6v2h14v-2H5zm0 4v4h14v-4H5z"/>
            </graphic>
        </Button>
    </HBox>

    <TableView fx:id="audioTable" VBox.vgrow="ALWAYS" styleClass="audio-table">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="No audio items found" styleClass="placeholder-text"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="titleColumn" text="Title" prefWidth="260.0">
                <cellValueFactory>
                    <PropertyValueFactory property="title"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="durationColumn" text="Duration" prefWidth="110.0">
                <cellValueFactory>
                    <PropertyValueFactory property="duration"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="150.0">
                <cellValueFactory>
                    <PropertyValueFactory property="category"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="sourceColumn" text="Source" prefWidth="130.0">
                <cellValueFactory>
                    <PropertyValueFactory property="source"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="languageColumn" text="Language" prefWidth="130.0">
                <cellValueFactory>
                    <PropertyValueFactory property="language"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="120.0">
                <cellValueFactory>
                    <PropertyValueFactory property="date"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="actionsColumn" sortable="false" resizable="false" reorderable="false"
                         minWidth="56.0" prefWidth="56.0" maxWidth="56.0"/>
        </columns>
    </TableView>
</VBox>